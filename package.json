{
  "name": "BOLDreflectR",
  "productName": "BOLDreflectR",
  "version": "1.0.0-rc1",
  "description": "A graphical user interface for BOLDconnectR (https://doi.org/10.32614/CRAN.package.BOLDconnectR) and BOLD's data APIs, allowing retrieval, exploration, and analysis of DNA barcode data. This installable executable is bundled using a modified version of nhyris (original: https://github.com/jahnen/nhyris; fork: https://github.com/skmonckton/nhyris).",
  "main": "src/index.js",
  "nhyris": {
    "trustedLinkHosts": ["boldsystems.org", "openstreetmap.org", "stadiamaps.com", "stamen.com", "esri.com", "leafletjs.com", "plotly.com"]
  },
  "author": {
    "name": "Spencer K. Monckton",
    "email": "smonckto@uoguelph.ca"
  },
  "contributors": [
    {
      "name": "Sameer Padhye",
      "email": "spadhye@uoguelph.ca"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skmonckton/BOLDreflectR"
  },
  "dependencies": {
    "electron-context-menu": "^5.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@reforged/maker-appimage": "^5.2.0",
    "electron": "^45.0.0"
  },
  "scripts": {
    "install-R": "node src/install-R.js"
  }
}
